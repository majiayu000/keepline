 impl PlatformWindow for MacWindow {
+    /// keepline-eval patch: GPUI calls this when the window becomes dirty. While the display link
+    /// is paused for idleness, restart it so the pending frame is drawn on the next vsync.
+    fn frame_waker(&self) -> Option<std::rc::Rc<dyn Fn()>> {
+        if !self.0.lock().pause_idle {
+            return None;
+        }
+        let weak = Arc::downgrade(&self.0);
+        Some(std::rc::Rc::new(move || {
+            if let Some(state) = weak.upgrade() {
+                let mut lock = state.lock();
+                lock.frame_demand = true;
+                lock.idle_frames = 0;
+                if lock.paused_for_idle {
+                    lock.paused_for_idle = false;
+                    lock.start_display_link();
+                }
+            }
+        }))
+    }
+
     fn bounds(&self) -> Bounds<Pixels> {
         self.0.as_ref().lock().bounds()
     }
@@ -3327,13 +3362,27 @@ extern "C" fn step(view: *mut c_void) {
                 (None, FrameRequestSource::NativeCallback),
                 |(at, source)| (Some(at), source),
             );
+        lock.frame_demand = false;
         drop(lock);
         callback(RequestFrameOptions {
             signal_at,
             signal_source,
             ..Default::default()
         });
-        window_state.lock().request_frame_callback = Some(callback);
+        let mut lock = window_state.lock();
+        lock.request_frame_callback = Some(callback);
+        // keepline-eval patch: after a few vsyncs without new demand, pause the display link.
+        if lock.pause_idle {
+            if lock.frame_demand {
+                lock.idle_frames = 0;
+            } else {
+                lock.idle_frames += 1;
+                if lock.idle_frames >= lock.idle_frames_limit {
+                    lock.stop_display_link();
+                    lock.paused_for_idle = true;
+                }
+            }
+        }
     }
 }
 
