+        layer: &metal::MetalLayer,
+        scene: &Scene,
+        viewport_size: Size<DevicePixels>,
+    ) {
+        let (w, h) = (viewport_size.width.0, viewport_size.height.0);
+        if w <= 0 || h <= 0 {
+            return;
+        }
+        let stale = self
