+/// keepline-eval patch: KEEPLINE_FRAME_STATS=1 prints frames, GPU time per frame and
+/// scene composition every two seconds to stderr.
+mod frame_stats {
+    use gpui::Scene;
+    use objc2::{msg_send, runtime::AnyObject};
+    use std::sync::{Mutex, OnceLock};
+    #[derive(Default)]
+    struct Stats {
+        frames: u64,
+        gpu: f64,
+        max_gpu: f64,
+        quads: usize,
+        mono: usize,
+        poly: usize,
+        paths: usize,
+        shadows: usize,
+        batches: usize,
+        skipped: u64,
+        damage: f64,
+        damaged: u64,
+        start: Option<std::time::Instant>,
+    }
+    fn enabled() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("KEEPLINE_FRAME_STATS").is_some())
+    }
+    static STATS: Mutex<Option<Stats>> = Mutex::new(None);
+    pub fn scene(scene: &Scene) {
+        if !enabled() {
+            return;
+        }
+        let mut lock = STATS.lock().unwrap();
+        let s = lock.get_or_insert_with(Default::default);
+        s.quads = scene.quads.len();
+        s.mono = scene.monochrome_sprites.len();
+        s.poly = scene.polychrome_sprites.len();
+        s.paths = scene.paths.len();
+        s.shadows = scene.shadows.len();
+        s.batches = scene.batches().count();
+    }
+    pub fn skipped() {
+        if !enabled() {
+            return;
+        }
+        STATS.lock().unwrap().get_or_insert_with(Default::default).skipped += 1;
+    }
+    pub fn damage(rects: Option<&[crate::damage::Rect]>, w: i32, h: i32) {
+        if !enabled() {
+            return;
+        }
+        let area: i64 = rects.map_or(w as i64 * h as i64, |r| {
+            r.iter().map(|r| (r.x1 - r.x0) as i64 * (r.y1 - r.y0) as i64).sum()
+        });
+        let mut lock = STATS.lock().unwrap();
+        let s = lock.get_or_insert_with(Default::default);
+        s.damage += area as f64 / (w as f64 * h as f64);
+        s.damaged += 1;
+    }
+    pub fn completed(buffer: std::ptr::NonNull<AnyObject>) {
+        if !enabled() {
+            return;
+        }
+        let buffer = unsafe { buffer.as_ref() };
+        let (a, b): (f64, f64) = unsafe { (msg_send![buffer, GPUStartTime], msg_send![buffer, GPUEndTime]) };
+        let mut lock = STATS.lock().unwrap();
+        let s = lock.get_or_insert_with(Default::default);
+        let now = std::time::Instant::now();
+        let start = *s.start.get_or_insert(now);
+        s.frames += 1;
+        s.gpu += b - a;
+        s.max_gpu = s.max_gpu.max(b - a);
+        let dt = now.duration_since(start).as_secs_f64();
+        if dt >= 2. {
+            eprintln!(
+                "frame-stats fps={:.1} gpu_ms_per_frame={:.3} max={:.3} gpu_ms_per_s={:.2} quads={} mono={} poly={} paths={} shadows={} batches={} skipped={} damage_share={:.3}",
+                s.frames as f64 / dt,
+                s.gpu * 1e3 / s.frames as f64,
+                s.max_gpu * 1e3,
+                s.gpu * 1e3 / dt,
+                s.quads, s.mono, s.poly, s.paths, s.shadows, s.batches,
+                s.skipped,
+                if s.damaged > 0 { s.damage / s.damaged as f64 } else { 1. }
+            );
+            *s = Stats { start: Some(now), ..Default::default() };
+        }
+    }
+}
