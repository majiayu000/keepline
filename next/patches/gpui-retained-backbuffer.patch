+//! keepline patch: frame-to-frame damage for a retained back buffer.
+//!
+//! Each primitive is reduced to a content hash (its draw order excluded, so primitives
+//! that did not move keep their identity when others are inserted) and its visible
+//! device-pixel rectangle. Primitives present in only one of two consecutive frames,
+//! as a multiset, damage their rectangles; the union is the only area that needs redraw.
+use gpui::{Bounds, ContentMask, ScaledPixels, Scene, TransformationMatrix};
+use std::hash::{Hash, Hasher};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Rect {
+    pub x0: i32,
+    pub y0: i32,
+    pub x1: i32,
+    pub y1: i32,
+}
+
+impl Rect {
+    fn union(self, o: Rect) -> Rect {
+        Rect {
+            x0: self.x0.min(o.x0),
+            y0: self.y0.min(o.y0),
+            x1: self.x1.max(o.x1),
+            y1: self.y1.max(o.y1),
+        }
+    }
+    fn is_empty(&self) -> bool {
+        self.x1 <= self.x0 || self.y1 <= self.y0
+    }
+    fn area(&self) -> i64 {
+        (self.x1 - self.x0) as i64 * (self.y1 - self.y0) as i64
+    }
+    pub fn clamp(self, w: i32, h: i32) -> Rect {
+        Rect {
+            x0: self.x0.clamp(0, w),
+            y0: self.y0.clamp(0, h),
+            x1: self.x1.clamp(0, w),
+            y1: self.y1.clamp(0, h),
+        }
+    }
+}
+
+/// What the next frame has to repaint.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Damage {
+    /// Identical to the frame already shown.
+    None,
+    /// These device-pixel rectangles, disjoint after merging.
+    Rects(Vec<Rect>),
+    Full,
+}
+
+/// Visible rectangle of a primitive: its bounds within its content mask, widened by
+/// `outset` device pixels for antialiasing and blur, snapped outwards to whole pixels.
+fn visible(bounds: &Bounds<ScaledPixels>, mask: &ContentMask<ScaledPixels>, outset: f32) -> Option<Rect> {
+    let b = bounds.intersect(&mask.bounds);
+    let (x0, y0) = (b.origin.x.0 - outset, b.origin.y.0 - outset);
+    let (x1, y1) = (b.origin.x.0 + b.size.width.0 + outset, b.origin.y.0 + b.size.height.0 + outset);
+    let r = Rect {
+        x0: x0.floor() as i32,
+        y0: y0.floor() as i32,
+        x1: x1.ceil() as i32,
+        y1: y1.ceil() as i32,
+    };
+    (!r.is_empty() && b.size.width.0 > 0. && b.size.height.0 > 0.).then_some(r)
+}
+
+/// A rotated or scaled sprite (an animated icon) draws its bounds mapped through its
+/// matrix, as the sprite shader does; the mask is not trusted to contain it.
+fn transformed(
+    bounds: &Bounds<ScaledPixels>,
+    mask: &ContentMask<ScaledPixels>,
+    m: &TransformationMatrix,
+) -> Option<Rect> {
+    if *m == TransformationMatrix::unit() {
+        return visible(bounds, mask, 1.);
+    }
+    let (x, y, w, h) = (bounds.origin.x.0, bounds.origin.y.0, bounds.size.width.0, bounds.size.height.0);
+    let map = |px: f32, py: f32| {
+        let r = m.rotation_scale;
+        (r[0][0] * px + r[0][1] * py + m.translation[0], r[1][0] * px + r[1][1] * py + m.translation[1])
+    };
+    let corners = [map(x, y), map(x + w, y), map(x, y + h), map(x + w, y + h)];
+    let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+    for (cx, cy) in corners {
+        x0 = x0.min(cx);
+        y0 = y0.min(cy);
+        x1 = x1.max(cx);
+        y1 = y1.max(cy);
+    }
+    let r = Rect {
+        x0: (x0 - 2.).floor() as i32,
+        y0: (y0 - 2.).floor() as i32,
+        x1: (x1 + 2.).ceil() as i32,
+        y1: (y1 + 2.).ceil() as i32,
+    };
+    (!r.is_empty()).then_some(r)
+}
+
+/// Hashes a padding-free `repr(C)` GPU primitive past its leading `order: DrawOrder` word.
+fn hash_pod<T: Copy>(tag: u8, value: &T) -> u64 {
+    hash_words(tag, value, 1)
+}
+
+fn hash_words<T: Copy>(tag: u8, value: &T, skip: usize) -> u64 {
+    const { assert!(std::mem::size_of::<T>() % 4 == 0 && std::mem::align_of::<T>() >= 4) };
+    // SAFETY: every primitive hashed here is `repr(C)` built only from 4-byte fields
+    // and explicit pad words, so its bytes are initialized words.
+    let words = unsafe {
+        std::slice::from_raw_parts(value as *const T as *const u32, std::mem::size_of::<T>() / 4)
+    };
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    tag.hash(&mut h);
+    words[skip..].hash(&mut h);
+    h.finish()
+}
+
+#[derive(Default)]
+pub struct Tracker {
+    previous: Vec<(u64, Rect)>,
+    size: (i32, i32),
+    valid: bool,
+}
+
+/// Above this share of the window, a partial redraw saves too little to bother.
+const FULL_SHARE: f64 = 0.6;
+const MAX_RECTS: usize = 4;
+
+impl Tracker {
+    pub fn invalidate(&mut self) {
+        self.valid = false;
+    }
+
+    pub fn update(&mut self, scene: &Scene, width: i32, height: i32) -> Damage {
+        let mut current = Vec::with_capacity(
+            scene.quads.len() + scene.monochrome_sprites.len() + scene.polychrome_sprites.len() + 16,
+        );
+        let mut surfaces = Vec::new();
+        for q in &scene.quads {
+            if let Some(r) = visible(&q.bounds, &q.content_mask, 1.) {
+                current.push((hash_pod(0, q), r));
+            }
+        }
+        for s in &scene.monochrome_sprites {
+            if let Some(r) = transformed(&s.bounds, &s.content_mask, &s.transformation) {
+                current.push((hash_pod(1, s), r));
+            }
+        }
+        for s in &scene.subpixel_sprites {
+            if let Some(r) = transformed(&s.bounds, &s.content_mask, &s.transformation) {
+                current.push((hash_pod(2, s), r));
+            }
+        }
+        for s in &scene.polychrome_sprites {
+            if let Some(r) = visible(&s.bounds, &s.content_mask, 1.) {
+                current.push((hash_pod(3, s), r));
+            }
+        }
+        for u in &scene.underlines {
+            if let Some(r) = visible(&u.bounds, &u.content_mask, 2.) {
+                current.push((hash_pod(4, u), r));
+            }
+        }
+        for s in &scene.shadows {
+            // The blur spreads beyond the bounds.
+            let outset = s.blur_radius.0 * 3. + 2.;
+            if let Some(r) = visible(&s.bounds, &s.content_mask, outset) {
+                current.push((hash_pod(5, s), r));
+            }
+        }
+        for p in &scene.paths {
+            if let Some(r) = visible(&p.bounds, &p.content_mask, 2.) {
+                let mut h = std::collections::hash_map::DefaultHasher::new();
+                6u8.hash(&mut h);
+                for v in &p.vertices {
+                    v.xy_position.x.0.to_bits().hash(&mut h);
+                    v.xy_position.y.0.to_bits().hash(&mut h);
+                    v.st_position.x.to_bits().hash(&mut h);
+                    v.st_position.y.to_bits().hash(&mut h);
+                }
+                hash_words(7, &p.color, 0).hash(&mut h);
+                current.push((h.finish(), r));
+            }
+        }
+        // Video frames change without their primitive changing.
+        for s in &scene.surfaces {
+            if let Some(r) = visible(&s.bounds, &s.content_mask, 1.) {
+                surfaces.push(r);
+            }
+        }
+        current.sort_unstable_by_key(|(h, r)| (*h, r.x0, r.y0, r.x1, r.y1));
+
+        let full = !self.valid || self.size != (width, height);
+        let previous = std::mem::replace(&mut self.previous, current);
+        self.size = (width, height);
+        self.valid = true;
+        if full {
+            return Damage::Full;
+        }
+
+        let mut rects = surfaces;
+        rects.extend(changed(&previous, &self.previous));
+        let rects: Vec<Rect> = rects
+            .into_iter()
+            .map(|r| r.clamp(width, height))
+            .filter(|r| !r.is_empty())
+            .collect();
+        if rects.is_empty() {
+            return Damage::None;
+        }
+        let merged = merge(rects);
+        let area: i64 = merged.iter().map(Rect::area).sum();
+        if merged.len() > MAX_RECTS || area as f64 > FULL_SHARE * (width as f64 * height as f64) {
+            return Damage::Full;
+        }
+        Damage::Rects(merged)
+    }
+}
+
+/// Rectangles of entries present in only one of two sorted lists, counted as multisets.
+fn changed(previous: &[(u64, Rect)], current: &[(u64, Rect)]) -> Vec<Rect> {
+    let key = |(h, r): &(u64, Rect)| (*h, r.x0, r.y0, r.x1, r.y1);
+    let mut rects = Vec::new();
+    let (mut i, mut j) = (0, 0);
+    while i < previous.len() || j < current.len() {
+        match (previous.get(i).map(key), current.get(j).map(key)) {
+            (Some(a), Some(b)) if a == b => {
+                i += 1;
+                j += 1;
+            }
+            (Some(a), Some(b)) if a < b => {
+                rects.push(previous[i].1);
+                i += 1;
+            }
+            (Some(_), None) => {
+                rects.push(previous[i].1);
+                i += 1;
+            }
+            _ => {
+                rects.push(current[j].1);
+                j += 1;
+            }
+        }
+    }
+    rects
+}
+
+/// Greedily unions rectangles that touch or whose union wastes little area, until the
+/// remaining ones are disjoint.
+fn merge(mut rects: Vec<Rect>) -> Vec<Rect> {
+    loop {
+        let mut changed = false;
+        let mut out: Vec<Rect> = Vec::with_capacity(rects.len());
+        for r in rects {
+            if let Some(o) = out.iter_mut().find(|o| {
+                let u = o.union(r);
+                let overlaps = o.x0 <= r.x1 && r.x0 <= o.x1 && o.y0 <= r.y1 && r.y0 <= o.y1;
+                overlaps || u.area() <= (o.area() + r.area()) * 2
+            }) {
+                *o = o.union(r);
+                changed = true;
+            } else {
+                out.push(r);
+            }
+        }
+        rects = out;
+        if !changed || rects.len() <= 1 {
+            return rects;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn r(x0: i32, y0: i32, x1: i32, y1: i32) -> Rect {
+        Rect { x0, y0, x1, y1 }
+    }
+
+    #[test]
+    fn unchanged_lists_damage_nothing() {
+        let a = vec![(1, r(0, 0, 10, 10)), (2, r(20, 0, 30, 10))];
+        assert!(changed(&a, &a).is_empty());
+    }
+
+    #[test]
+    fn a_moved_primitive_damages_where_it_was_and_where_it_is() {
+        let a = vec![(1, r(0, 0, 10, 10)), (2, r(50, 50, 60, 60))];
+        let mut b = vec![(1, r(0, 0, 10, 10)), (2, r(70, 50, 80, 60))];
+        b.sort_unstable_by_key(|(h, r)| (*h, r.x0, r.y0, r.x1, r.y1));
+        assert_eq!(changed(&a, &b), vec![r(50, 50, 60, 60), r(70, 50, 80, 60)]);
+    }
+
+    #[test]
+    fn duplicates_count_as_a_multiset() {
+        // Two identical glyphs drawn at the same place, one removed: still damage.
+        let a = vec![(7, r(0, 0, 8, 16)), (7, r(0, 0, 8, 16))];
+        let b = vec![(7, r(0, 0, 8, 16))];
+        assert_eq!(changed(&a, &b), vec![r(0, 0, 8, 16)]);
+    }
+
+    #[test]
+    fn changed_content_in_place_damages_once() {
+        let a = vec![(1, r(0, 0, 8, 16))];
+        let b = vec![(2, r(0, 0, 8, 16))];
+        assert_eq!(merge(changed(&a, &b)), vec![r(0, 0, 8, 16)]);
+    }
+
+    #[test]
+    fn far_apart_rects_stay_separate_and_near_ones_merge() {
+        let merged = merge(vec![r(0, 0, 10, 10), r(12, 0, 22, 10), r(500, 500, 510, 510)]);
+        assert_eq!(merged, vec![r(0, 0, 22, 10), r(500, 500, 510, 510)]);
+    }
+
+    #[test]
+    fn first_frame_and_resize_are_full() {
+        let scene = Scene::default();
+        let mut t = Tracker::default();
+        assert_eq!(t.update(&scene, 100, 100), Damage::Full);
+        assert_eq!(t.update(&scene, 100, 100), Damage::None);
+        assert_eq!(t.update(&scene, 120, 100), Damage::Full);
+        t.invalidate();
+        assert_eq!(t.update(&scene, 120, 100), Damage::Full);
+    }
+}
